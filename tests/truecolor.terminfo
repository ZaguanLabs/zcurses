# Controlled descriptions for PTY tests, compiled only into .build/.
# The direct entry reserves the eight ANSI indices, as xterm-direct does.
zcurses-test-rgb-base|test 24-bit direct color transport,
	colors#0x1000000, pairs#0x10000, CO#8,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e38;2;%p1%{65536}%/%d;%p1%{256}%/%{255}%&%d;%p1%{255}%&%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e48;2;%p1%{65536}%/%d;%p1%{256}%/%{255}%&%d;%p1%{255}%&%d%;m,
	use=xterm-256color,
zcurses-test-rgb|test Boolean RGB encoding,
	RGB, use=zcurses-test-rgb-base,
zcurses-test-rgb-number|test numeric RGB encoding,
	RGB#8, use=zcurses-test-rgb-base,
zcurses-test-rgb-string|test string RGB encoding,
	RGB=8/8/8, use=zcurses-test-rgb-base,
zcurses-test-rgb-wrong|test unsupported RGB encoding,
	RGB#5, use=zcurses-test-rgb-base,
zcurses-test-rgb-small|test insufficient color range,
	RGB, colors#256, use=zcurses-test-rgb-base,
zcurses-test-rgb-exact|test RGB encoding without palette reservations,
	RGB, CO#0,
	setaf=\E[38;2;%p1%{65536}%/%d;%p1%{256}%/%{255}%&%d;%p1%{255}%&%dm,
	setab=\E[48;2;%p1%{65536}%/%d;%p1%{256}%/%{255}%&%d;%p1%{255}%&%dm,
	use=zcurses-test-rgb-base,
